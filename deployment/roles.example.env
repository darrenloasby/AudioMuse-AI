# Role-lane deployment example. Copy values into the deployment repository;
# never commit live credentials or host-specific paths here.

# Coordinator (the existing server-side process)
ANALYSIS_PIPELINE=staged
ANALYSIS_ARTIFACT_ROOT=/shared/audiomuse/staged

# Native worker policy. 'worker' retains models between queue jobs.
MODEL_LIFETIME=worker
MUSICNN_COREML_ENABLED=true

# Xenon worker profiles. Start separate processes with one profile per lane.
# A process may advertise more than one capability when its memory budget allows.
XENON_MUSICNN_CAPABILITIES=musicnn
XENON_CLAP_CAPABILITIES=clap_audio
XENON_LYRICS_CAPABILITIES=lyrics_asr

# Argon fallback/catch-up profile.
ARGON_ANALYSIS_CAPABILITIES=musicnn,clap_audio,lyrics_asr

# Every worker must point at the same PostgreSQL task database and artifact root.
# DATABASE_URL=provided-by-deployment-secret-store
# AUDIO_MUSE_LISTENER_ID=unique-per-process
